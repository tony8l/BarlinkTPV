<?xml version="1.0" encoding="utf-8" ?>
<Shell 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="BarlinkTPV.Navigation.UserNavigation"
    xmlns:local="clr-namespace:BarlinkTPV.Views"
    FlyoutBehavior="Flyout"
    Shell.NavBarIsVisible="False"
    FlyoutBackgroundColor="{DynamicResource ColorFondoFlyout}">

    <Shell.Resources>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextColor" Value="{DynamicResource ColorTextoPequeno}"/>
        </Style>
    </Shell.Resources>
    
    <ShellContent
        ContentTemplate="{DataTemplate local:HomeView}"
        Route="HomeView"
        Title="Inicio"
        Shell.FlyoutBehavior="Disabled"/>

    <ShellContent
        ContentTemplate="{DataTemplate local:PosView}"
        Route="PosView"
        Title="Caja"/>

    <ShellContent
        ContentTemplate="{DataTemplate local:UsersManagementView}"
        Route="UsersManagementView"
        Title="Gestionar Empleados"/>

    <ShellContent
        ContentTemplate="{DataTemplate local:SettingsView}"
        Route="SettingsView"
        Title="Ajustes"/>

    <MenuItem 
        x:Name="btnSalir"
        Text="Salir"
        Clicked="btnSalir_Clicked"/>
</Shell>