<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BarlinkTPV.Views.OrderView"
             BackgroundColor="{DynamicResource ColorFondoPrincipal}">
    <Grid
        ColumnDefinitions="*,*">

        <!--#region MITAD IZQUIERDA -->
        <Border
            Grid.Column="0"
            Margin="10">

            <Grid
                RowDefinitions="*,*"
                RowSpacing="10">
                <VerticalStackLayout
                    Grid.Row="0"
                    Padding="10"
                    Spacing="20">
                    <!-- BARRA SUPERIOR -->
                    <HorizontalStackLayout
                        Padding="10"
                        Spacing="10"
                        HorizontalOptions="Center">
                        <Label
                            Text="MESA Nº: "
                            TextColor="Black"/>
                        <Label
                            x:Name="lblNumMesa"
                            Text="A20"
                            TextColor="Black"/>
                        <Label
                            Text="ESTADO: "
                            TextColor="Black"
                            Margin="100,0,0,0"/>
                        <Label
                            x:Name="lblEstadoCobro"
                            Text="ABIERTO"
                            TextColor="Black"/>
                    </HorizontalStackLayout>
                    
                    <!-- TABLA SYNCFUSION LINEAS -->
                    <Border
                        HeightRequest="350">
                    </Border>

                    <Border
                        HeightRequest="50">
                        
                    </Border>
                    
                </VerticalStackLayout>


                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="*,*"
                    Padding="10"
                    ColumnSpacing="30">
                    <!--#region TECLADO NUMPAD -->
                    <Grid
                        Grid.Column="0"
                        ColumnDefinitions="*,*,*"
                        RowDefinitions="*,*,*,*,*"
                        ColumnSpacing="10"
                        RowSpacing="10">

                        <Button
                            Text="7"
                            Grid.Column="0"
                            Grid.Row="0"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"/>

                        <Button
                            Text="8"
                            Grid.Column="1"
                            Grid.Row="0"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"/>

                        <Button
                            Text="9"
                            Grid.Column="2"
                            Grid.Row="0"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"/>

                        <Button
                            Text="4"
                            Grid.Column="0"
                            Grid.Row="1"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"/>

                        <Button
                            Text="5"
                            Grid.Column="1"
                            Grid.Row="1"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"/>

                        <Button
                            Text="6"
                            Grid.Column="2"
                            Grid.Row="1"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"/>

                        <Button
                            Text="1"
                            Grid.Column="0"
                            Grid.Row="2"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"/>

                        <Button
                            Text="2"
                            Grid.Column="1"
                            Grid.Row="2"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"/>

                        <Button
                            Text="3"
                            Grid.Column="2"
                            Grid.Row="2"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"/>

                        <Button
                            Text="."
                            Grid.Column="0"
                            Grid.Row="3"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"/>
                        <Button
                            Text="0"
                            Grid.Column="1"
                            Grid.Row="3"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"/>

                        <Button
                            x:Name="numPadBorrar"
                            Text="&lt;&lt;"
                            Grid.Column="2"
                            Grid.Row="3"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"/>

                        <Button
                            Text="ABRIR CAJÓN"
                            Grid.Row="4"
                            Grid.ColumnSpan="3"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"/>
                    </Grid>
                    <!--#endregion-->
                    <Grid
                        Grid.Column="1"
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="*,*,*,*,*"
                        ColumnSpacing="10"
                        RowSpacing="10">
                        <Button
                            x:Name="btnEliminarProducto"
                            Grid.Row="0"
                            Text="Eliminar producto"/>
                        <Button
                            x:Name="btnEliminarTodo"
                            Grid.Row="1"
                            Text="Borrar productos"/>
                        <Button
                            x:Name="btnCancelarTicket"
                            Grid.Row="2"
                            Text="Cancelar ticket"/>
                        <Button
                            x:Name="btnImprimirCuenta"
                            Grid.Row="3"
                            Text="Imprimir cuenta"/>
                        <Button
                            x:Name="btnSalir"
                            Grid.Row="4"
                            Text="Salir"/>
                        <Button
                            Grid.Column="1"
                            Grid.RowSpan="5"
                            WidthRequest="100"
                            Text="COBRAR"/>
                    </Grid>
                    
                </Grid>
            </Grid>
            
        </Border>
        <!--#endregion-->

        <!--#region MITAD DERECHA -->
        <Border
            Grid.Column="1"
            BackgroundColor="{DynamicResource ColorPanelSecundario}"
            Margin="10">

            <Grid
                RowDefinitions="*,2*"
                Padding="10"
                RowSpacing="10">

                <Border
                    Grid.Row="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">

                    <ScrollView>
                        <VerticalStackLayout
                            Padding="20"
                            Spacing="15">
                            <CollectionView
                                x:Name="categoriasCollection"
                                SelectionMode="Single"
                                SelectionChanged="categoriasCollection_SelectionChanged">

                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="6" />
                                </CollectionView.ItemsLayout>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Stroke="Orange"
                                            StrokeShape="RoundRectangle 5"
                                            WidthRequest="120"
                                            HeightRequest="100">
                                            <VerticalStackLayout>
                                                <Label
                                                    Text="{Binding Nombre}"
                                                    TextColor="Black"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                        </VerticalStackLayout>
                    </ScrollView>
                </Border>

                <Border
                    Grid.Row="1"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">

                    <ScrollView>
                        <VerticalStackLayout
                            Padding="20"
                            Spacing="15">
                            <CollectionView
                                x:Name="productosCollection"
                                SelectionMode="Single"
                                SelectionChanged="productosCollection_SelectionChanged">

                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="6" />
                                </CollectionView.ItemsLayout>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Stroke="Orange"
                                            StrokeShape="RoundRectangle 5"
                                            WidthRequest="120"
                                            HeightRequest="100">
                                            <VerticalStackLayout
                                                Spacing="5">
                                                <Label
                                                    Text="{Binding Nombre}"
                                                    TextColor="Black"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </ScrollView>
                </Border>
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</ContentPage>