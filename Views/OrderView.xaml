<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BarlinkTPV.Views.OrderView"
             xmlns:local="clr-namespace:BarlinkTPV.Models"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             BackgroundColor="{DynamicResource ColorFondoPrincipal}">

    <ContentPage.BindingContext>
        <local:Ticket x:Name="coleccionLineas"/>
    </ContentPage.BindingContext>

    <Grid
        ColumnDefinitions="*,*">

        <!--#region MITAD IZQUIERDA -->
        <!-- Contenedor general del lado izquierdo -->
        <Border
            Grid.Column="0"
            Margin="10">

            <!-- Tabla que divide en mitad superior e inferior (Ticket | Teclado) -->
            <Grid
                RowDefinitions="*,*"
                RowSpacing="10">
                
                <!--#region MITAD SUPERIOR IZQUIERDA -->
                <!--Tabla que divide la mitad superior en 3 zonas 
                    Barra de info superior
                    Tabla de las lineas delticket
                    Informe del ticket -->
                <Grid
                    RowDefinitions="Auto,*,Auto"
                    Grid.Row="0"
                    Padding="10"
                    RowSpacing="10">
                    <!-- Tabla que muestra la info general de la mesa en la parte superior -->
                    <Grid
                        ColumnDefinitions="Auto,*,Auto,*,Auto,Auto"
                        ColumnSpacing="5"
                        Padding="5">
                        <Label
                            Grid.Column="0"
                            Text="{DynamicResource OrderView_MesaNumero}"
                            Style="{DynamicResource Label}"/>
                        <Label
                            Grid.Column="1"
                            x:Name="lblNumMesa"
                            Style="{DynamicResource Label}"/>
                        <Label
                            Grid.Column="2"
                            Text="{DynamicResource OrderView_Estado}"
                            Style="{DynamicResource Label}"/>
                        <Label
                            Grid.Column="3"
                            x:Name="lblEstadoCobro"
                            Style="{DynamicResource Label}"/>

                        <Label
                            Grid.Column="4"
                            x:Name="lblCantidadTxt"
                            Text="{DynamicResource OrderView_CantidadTexto}"
                            Style="{DynamicResource Label}"/>

                        <Label
                            Grid.Column="5"
                            x:Name="lblCantidadValue"
                            Text="1"
                            Style="{DynamicResource Label}"/>
                    </Grid>

                    <!-- TABLA SYNCFUSION LINEAS -->
                    
                    <syncfusion:SfDataGrid
                        x:Name="dataGridLineas"
                        ColumnWidthMode="Fill"
                        Grid.Row="1"
                        ItemsSource="{Binding Lineas}"
                        AutoGenerateColumnsMode="None" 
                        ScrollingMode="Line" 
                        NavigationMode="Row" 
                        NewItemPlaceholderPosition="AtEnd"
                        SelectionMode="Single"
                        SelectionChanged="dataGridLineas_SelectionChanged"
                        DefaultStyle="{DynamicResource SyncfusionDataGridStyle}">

                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:DataGridNumericColumn 
                                HeaderText="Cantidad"
                                MappingName="Cantidad"
                                Width="150"
                                Format="0"/>
                            <syncfusion:DataGridTextColumn
                                HeaderText="Nombre"
                                MappingName="NombreProducto"
                                Width="150"/>

                            <syncfusion:DataGridNumericColumn
                                HeaderText="Precio Ud."
                                MappingName="PrecioUd"
                                Format="N2"
                                />
                            
                            <syncfusion:DataGridNumericColumn
                                HeaderText="Total"
                                MappingName="Total"
                                Format="N2"
                                />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>

                    <!-- Contenedor que muestra un informe del ticket en general -->
                    <Border
                        Grid.Row="2"
                        HeightRequest="50">
                        <Grid
                            ColumnDefinitions="2*,*,Auto,*,Auto"
                            VerticalOptions="Center">
                            <Label
                                Grid.Column="1"
                                Text="{DynamicResource OrderView_TotalIva}"
                                Style="{DynamicResource Label}"
                                HorizontalOptions="End"
                                CharacterSpacing="1"
                                Margin="0,0,5,0"/>
                            <Label
                                x:Name="lblTotalIvaValue"
                                Grid.Column="2"
                                Style="{DynamicResource Label}"/>
                            <Label
                                Grid.Column="3"
                                Text="{DynamicResource OrderView_ImporteTotal}"
                                Style="{DynamicResource Label}"
                                HorizontalOptions="End"
                                CharacterSpacing="1"
                                Margin="0,0,5,0"/>
                            <Label
                                x:Name="lblImporteTotalValue"
                                Grid.Column="4"
                                Style="{DynamicResource Label}"
                                Margin="0,0,20,0"/>
                        </Grid>

                    </Border>
                </Grid>
                <!--#endregion-->

                <!--#region MITAD INFERIOR IZQUIERDA -->
                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="*,*"
                    Padding="10"
                    ColumnSpacing="30">
                    <!--#region TECLADO NUMPAD -->
                    <Grid
                        Grid.Column="0"
                        ColumnDefinitions="*,*,*"
                        RowDefinitions="*,*,*,*,*"
                        ColumnSpacing="10"
                        RowSpacing="10">

                        <Button
                            Text="7"
                            Grid.Column="0"
                            Grid.Row="0"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            Clicked="NumpadButton_Clicked"/>

                        <Button
                            Text="8"
                            Grid.Column="1"
                            Grid.Row="0"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            Clicked="NumpadButton_Clicked"/>

                        <Button
                            Text="9"
                            Grid.Column="2"
                            Grid.Row="0"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            Clicked="NumpadButton_Clicked"/>

                        <Button
                            Text="4"
                            Grid.Column="0"
                            Grid.Row="1"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            Clicked="NumpadButton_Clicked"/>

                        <Button
                            Text="5"
                            Grid.Column="1"
                            Grid.Row="1"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            Clicked="NumpadButton_Clicked"/>

                        <Button
                            Text="6"
                            Grid.Column="2"
                            Grid.Row="1"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            Clicked="NumpadButton_Clicked"/>

                        <Button
                            Text="1"
                            Grid.Column="0"
                            Grid.Row="2"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            Clicked="NumpadButton_Clicked"/>

                        <Button
                            Text="2"
                            Grid.Column="1"
                            Grid.Row="2"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            Clicked="NumpadButton_Clicked"/>

                        <Button
                            Text="3"
                            Grid.Column="2"
                            Grid.Row="2"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            Clicked="NumpadButton_Clicked"/>

                        <Button
                            Text="."
                            Grid.Column="0"
                            Grid.Row="3"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            Clicked="NumpadButton_Clicked"/>
                        <Button
                            Text="0"
                            Grid.Column="1"
                            Grid.Row="3"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            Clicked="NumpadButton_Clicked"/>

                        <Button
                            x:Name="numPadBorrar"
                            Text="&lt;&lt;"
                            Grid.Column="2"
                            Grid.Row="3"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            Clicked="numPadBorrar_Clicked"/>

                        <Button
                            x:Name="btnAbrirCajon"
                            Text="{DynamicResource OrderView_AbrirCajon}"
                            Grid.Row="4"
                            Grid.ColumnSpan="3"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            Clicked="btnAbrirCajon_Clicked"/>
                    </Grid>
                    <!--#endregion-->
                    <!--#region BOTONES OPCIONES DE CAJA -->
                    <Grid
                        Grid.Column="1"
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="*,*,*,*,*"
                        ColumnSpacing="10"
                        RowSpacing="10">
                        <!-- Botón que elimina una sola linea -->
                        <Button
                            x:Name="btnEliminarProducto"
                            Grid.Row="0"
                            Text="{DynamicResource OrderView_BorrarFila}"
                            Clicked="btnEliminarProducto_Clicked"/>
                        
                        <!-- Botón que elimina todas las lineas -->
                        <Button
                            x:Name="btnEliminarTodo"
                            Grid.Row="1"
                            Text="{DynamicResource OrderView_BorrarTodo}"
                            Clicked="btnEliminarTodo_Clicked"/>
                        
                        <!-- Botón para editar la cantidad de una linea -->
                        <Button
                            x:Name="btnEditarLinea"
                            Grid.Row="2"
                            Text="{DynamicResource OrderView_EditarLinea}"
                            Clicked="btnEditarLinea_Clicked"/>
                        
                        <!-- Botón que cancela/borra el ticket de esa mesa -->
                        <Button
                            x:Name="btnCancelarTicket"
                            Grid.Row="3"
                            Text="{DynamicResource OrderView_CancelarTicket}"
                            Clicked="btnCancelarTicket_Clicked_1"/>
                        
                        <!-- Botón para salir de un ticket (guardando estado) -->
                        <Button
                            x:Name="btnSalir"
                            Grid.Row="4"
                            Text="{DynamicResource OrderView_Salir}"
                            Clicked="btnSalir_Clicked"/>
                        
                        <!-- Botón para iniciar un cobro -->
                        <Button
                            x:Name="btnCobrar"
                            Grid.Column="1"
                            Grid.RowSpan="5"
                            WidthRequest="100"
                            Text="{DynamicResource OrderView_Cobrar}"
                            Clicked="btnCobrar_Clicked"/>
                    </Grid>
                    <!--#endregion-->
                </Grid>
                <!--#endregion-->
            </Grid>
            
        </Border>
        <!--#endregion-->

        <!--#region MITAD DERECHA -->
        <Border
            Grid.Column="1"
            BackgroundColor="{DynamicResource ColorPanelSecundario}"
            Margin="10">

            <Grid
                RowDefinitions="*,2*"
                Padding="10"
                RowSpacing="10">

                <Border
                    Grid.Row="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">

                    <ScrollView>
                        <VerticalStackLayout
                            Padding="20"
                            Spacing="15">
                            <CollectionView
                                x:Name="categoriasCollection"
                                SelectionMode="Single"
                                SelectionChanged="categoriasCollection_SelectionChanged">

                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="5"/>
                                </CollectionView.ItemsLayout>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Style="{DynamicResource CardCategoria}">
                                            <VerticalStackLayout
                                                Spacing="5"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                                <Image
                                                    Source="{Binding NombreImagen}"
                                                    Aspect="AspectFit"
                                                    HeightRequest="60"/>
                                                <Label
                                                    Text="{Binding Nombre}"
                                                    Style="{DynamicResource Label}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    FontAttributes="None"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                        </VerticalStackLayout>
                    </ScrollView>
                </Border>

                <Border
                    Grid.Row="1"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">

                    <ScrollView>
                        <VerticalStackLayout
                            Padding="20"
                            Spacing="15">
                            <CollectionView
                                x:Name="productosCollection"
                                SelectionMode="Single"
                                SelectionChanged="productosCollection_SelectionChanged">

                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="5" />
                                </CollectionView.ItemsLayout>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Style="{DynamicResource CardProducto}">
                                            <VerticalStackLayout
                                                Spacing="5">
                                                <Image
                                                    Source="{Binding NombreImagen}"
                                                    Aspect="AspectFit"
                                                    HeightRequest="60"/>
                                                <Label
                                                    Text="{Binding Nombre}"
                                                    Style="{DynamicResource Label}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    FontAttributes="None"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </ScrollView>
                </Border>
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</ContentPage>