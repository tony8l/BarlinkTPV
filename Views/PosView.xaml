<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BarlinkTPV.Views.PosView"
             BackgroundColor="{DynamicResource ColorFondoPrincipal}">

    <Grid
        RowDefinitions="Auto,*,Auto,*">
        <Label 
            Text="{DynamicResource PosView_Sala}"
            Style="{DynamicResource Label}"
            Grid.Row="0"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="15">
                <CollectionView
                    x:Name="collectionMesasSala"
                    SelectionMode="Single"
                    SelectionChanged="collectionMesasSala_SelectionChanged">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="borderMesasSala"
                                Style="{DynamicResource CardMesa}">

                                <Border.Triggers>
                                    <DataTrigger 
                                        TargetType="Border"
                                        Binding="{Binding EstadoMesa}"
                                        Value="Libre">
                                        <Setter 
                                            Property="BackgroundColor" 
                                            Value="{DynamicResource ColorTarjetasMesa}"/>
                                    </DataTrigger>

                                    <DataTrigger 
                                        TargetType="Border"
                                        Binding="{Binding EstadoMesa}"
                                        Value="Ocupada">
                                        <Setter 
                                            Property="BackgroundColor" 
                                            Value="{DynamicResource ColorTarjetasMesaOcupada}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding CodigoMesa}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="White" />

                                    <Label Text="{Binding CategoriaMesa}"
                                           FontSize="14"
                                           TextColor="LightGray" />

                                    <Label Text="{Binding EstadoMesa}"
                                           FontSize="16"
                                           TextColor="Orange" />

                                    <Label Text="{Binding Bloqueada, StringFormat='{DynamicResource PosView_Bloqueada}'}"
                                       FontSize="14"
                                       TextColor="LightGray" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <Label 
            Text="{DynamicResource PosView_Terraza}"
            Style="{DynamicResource Label}"
            Grid.Row="2"/>

        <ScrollView Grid.Row="3">
            <VerticalStackLayout Padding="20" Spacing="15">
                <CollectionView
                    x:Name="collectionMesasTerraza"
                    SelectionMode="Single"
                    SelectionChanged="collectionMesasTerraza_SelectionChanged">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border 
                                x:Name="borderMesasTerraza"
                                Style="{DynamicResource CardMesa}">

                                <VerticalStackLayout Spacing="8">
                                    <Label 
                                        Text="{Binding CodigoMesa}"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="White" />

                                    <Label 
                                        Text="{Binding CategoriaMesa}"
                                        FontSize="14"
                                        TextColor="LightGray" />

                                    <Label 
                                        Text="{Binding EstadoMesa}"
                                        FontSize="16"
                                        TextColor="Orange" />

                                    <Label 
                                        Text="{Binding Bloqueada, StringFormat='{DynamicResource PosView_BloqueadaFormato}'}"
                                        FontSize="14"
                                        TextColor="LightGray" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>