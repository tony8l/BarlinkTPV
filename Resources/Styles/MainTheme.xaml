<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BarlinkTPV.Resources.Styles.MainTheme">

    <!-- ========================= -->
    <!-- Colores -->
    <!-- ========================= -->
    <Color x:Key="ColorTextoFlyout">#FFFFFF</Color>
    <Color x:Key="ColorTextoGrande">#1F2933</Color>
    <Color x:Key="ColorTextoPequeno">#5B6870</Color>

    <Color x:Key="ColorBotonPrincipalFondo">#2F6D67</Color>
    <Color x:Key="ColorBotonPrincipalTexto">#FFFDF8</Color>

    <Color x:Key="ColorBotonAlternativoFondo">#F3EFE7</Color>
    <Color x:Key="ColorBotonAlternativoTexto">#285A55</Color>

    <Color x:Key="ColorBotonCancelarFondo">#FF2B1C</Color>
    <Color x:Key="ColorBotonCancelarTexto">#FFFDF8</Color>

    <Color x:Key="ColorBorder">#D7DCCD</Color>

    <Color x:Key="ColorFondoPrincipal">#F8F6F1</Color>
    <Color x:Key="ColorFondoContenedores">#FFFCF7</Color>
    <Color x:Key="ColorFondoAlternativo">#5A928C</Color>
    <Color x:Key="ColorFondoFlyout">#5A928C</Color>

    <Color x:Key="ColorPanelSecundario">#EFE9DE</Color>

    <Color x:Key="ColorBotonCriticoFondo">#D96C3F</Color>
    <Color x:Key="ColorBotonCriticoTexto">#FFFDF9</Color>

    <Color x:Key="ColorBotonDeshabilitadoFondo">#C9D1C7</Color>
    <Color x:Key="ColorBotonDeshabilitadoTexto">#8B959A</Color>

    <Color x:Key="ColorEntryFondo">#FDFBF8</Color>
    <Color x:Key="ColorPlaceholder">#9AA4A6</Color>
    <Color x:Key="ColorEntryDeshabilitadoFondo">#ECE8E1</Color>
    <Color x:Key="ColorEntryDeshabilitadoTexto">#7E878C</Color>
    <Color x:Key="ColorEntryDeshabilitadoPlaceholder">#A8B0B3</Color>

    <Color x:Key="ColorTarjetasMesa">#5A928C</Color>
    <Color x:Key="ColorTarjetasMesaOcupada">#D96C3F</Color>
    <Color x:Key="ColorTarjetasProdCat">Orange</Color>

    <!-- ========================= -->
    <!-- Elementos genéricos -->
    <!-- ========================= -->

    <!-- Label pequeño genérico -->
    <Style TargetType="Label" x:Key="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoPequeno}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- Button genérico = botón principal -->
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorBotonPrincipalFondo}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorBotonPrincipalTexto}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorBotonDeshabilitadoFondo}" />
                            <Setter Property="TextColor" Value="{DynamicResource ColorBotonDeshabilitadoTexto}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Entry genérico -->
    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorEntryFondo}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoGrande}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorPlaceholder}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoContenedores}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorEntryDeshabilitadoFondo}" />
                            <Setter Property="TextColor" Value="{DynamicResource ColorEntryDeshabilitadoTexto}" />
                            <Setter Property="PlaceholderColor" Value="{DynamicResource ColorEntryDeshabilitadoPlaceholder}" />
                            <Setter Property="Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Border genérico -->
    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource ColorBorder}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoContenedores}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
    </Style>

    <!-- ========================= -->
    <!-- Elementos con x:Key -->
    <!-- ========================= -->

    <!-- Label de texto grande -->
    <Style x:Key="LabelTextoGrande" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoGrande}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="Montserrat" />
    </Style>

    <!-- Button alternativo -->
    <Style x:Key="BotonAlternativo" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorBotonAlternativoFondo}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorBotonAlternativoTexto}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{DynamicResource ColorBorder}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorBotonDeshabilitadoFondo}" />
                            <Setter Property="TextColor" Value="{DynamicResource ColorBotonDeshabilitadoTexto}" />
                            <Setter Property="BorderColor" Value="{DynamicResource ColorBorder}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Button Cancelar -->
    <Style x:Key="BotonCancelar" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorBotonCancelarFondo}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorBotonCancelarTexto}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{DynamicResource ColorBorder}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorBotonDeshabilitadoFondo}" />
                            <Setter Property="TextColor" Value="{DynamicResource ColorBotonDeshabilitadoTexto}" />
                            <Setter Property="BorderColor" Value="{DynamicResource ColorBorder}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ImgBotonSalir" TargetType="ImageButton">
        <Setter Property="Background" Value="{DynamicResource ColorBotonCancelarFondo}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="HeightRequest" Value="40"/>
        <Setter Property="WidthRequest" Value="40"/>
    </Style>

    <!-- Button de acción crítica -->
    <Style x:Key="BotonAccionCritica" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorBotonCriticoFondo}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorBotonCriticoTexto}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorBotonDeshabilitadoFondo}" />
                            <Setter Property="TextColor" Value="{DynamicResource ColorBotonDeshabilitadoTexto}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Border entry -->
    <Style x:Key="BorderEntry" TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource ColorBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoContenedores}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
    </Style>

    <!-- Label de texto medio -->
    <Style x:Key="LabelTextoMedio" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoGrande}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="Montserrat" />
    </Style>

    <!-- Tarjeta de mesa para PosView -->
    <Style x:Key="CardMesa" TargetType="Border">
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="6" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorTarjetasMesa}" />
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="Stroke" Value="Black"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
    </Style>

    <!-- Tarjeta de categoría para OrderView -->
    <Style x:Key="CardCategoria" TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource ColorTarjetasProdCat}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 5" />
        <Setter Property="WidthRequest" Value="130" />
        <Setter Property="HeightRequest" Value="110" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoContenedores}"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <!-- Tarjeta de producto para OrderView -->
    <Style x:Key="CardProducto" TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource ColorTarjetasProdCat}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 5" />
        <Setter Property="WidthRequest" Value="130" />
        <Setter Property="HeightRequest" Value="110" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondoContenedores}" />
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <Style TargetType="Picker">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorEntryFondo}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextoGrande}" />
        <Setter Property="TitleColor" Value="{DynamicResource ColorPlaceholder}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>

                <VisualStateGroup x:Name="CommonStates">

                    <VisualState x:Name="Normal" />

                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <!-- Mismo efecto que Entry -->
                            <Setter Property="BackgroundColor"
                                Value="{DynamicResource ColorFondoContenedores}" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                Value="{DynamicResource ColorEntryDeshabilitadoFondo}" />
                            <Setter Property="TextColor"
                                Value="{DynamicResource ColorEntryDeshabilitadoTexto}" />
                            <Setter Property="TitleColor"
                                Value="{DynamicResource ColorEntryDeshabilitadoPlaceholder}" />
                            <Setter Property="Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>

                </VisualStateGroup>

            </VisualStateGroupList>
        </Setter>
    </Style>
</ResourceDictionary>